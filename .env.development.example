# Copy to .env.development for local WSL development. Do not commit the copy.
RAILS_ENV=development
DISABLE_BULLET=true
VERBOSE_QUERY_LOGS=false
SECRET_KEY_BASE=<generate-with-bundle-exec-rails-secret>
FRONTEND_URL=http://localhost:3001
PORT=3001

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=
POSTGRES_DATABASE=tlin_app_dev

REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

DISABLE_ENTERPRISE=true
CAPTAIN_ENABLED=false
INSTALLATION_NAME=Tlin

# Baileys placeholders: leave empty until this provider is configured locally.
# BAILEYS_PROVIDER_DEFAULT_CLIENT_NAME=
# BAILEYS_PROVIDER_DEFAULT_URL=
# BAILEYS_PROVIDER_DEFAULT_API_KEY=
# BAILEYS_WHATSAPP_GROUPS_ENABLED=
