# Copy to .env.development for local WSL development. Do not commit the copy.
RAILS_ENV=development
DISABLE_BULLET=true
VERBOSE_QUERY_LOGS=false
SECRET_KEY_BASE=<generate-with-bundle-exec-rails-secret>
FRONTEND_URL=http://127.0.0.1:3001
PORT=3001

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=tlin_dev
POSTGRES_DATABASE=tlin_app_dev

REDIS_PORT=6380
REDIS_PASSWORD=tlin_redis_dev
REDIS_URL=redis://:tlin_redis_dev@localhost:6380

# Bind the Vite dev server on the WSL interface for Windows browser HMR.
VITE_RUBY_HOST=0.0.0.0
VITE_RUBY_PORT=3036

DISABLE_ENTERPRISE=true
CAPTAIN_ENABLED=false
INSTALLATION_NAME=Tlin

# Google OAuth local: paste the client ID and secret from Google Cloud Console locally.
# The authorized redirect URI must match this URL exactly. Do not commit credentials.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://127.0.0.1:3001/auth/google_oauth2/callback
ENABLE_GOOGLE_OAUTH_LOGIN=true

# Baileys placeholders: leave empty until this provider is configured locally.
# BAILEYS_PROVIDER_DEFAULT_CLIENT_NAME=
# BAILEYS_PROVIDER_DEFAULT_URL=
# BAILEYS_PROVIDER_DEFAULT_API_KEY=
# BAILEYS_WHATSAPP_GROUPS_ENABLED=
